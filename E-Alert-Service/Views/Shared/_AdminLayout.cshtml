<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdvansE-Alert</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light">
    <!-- Global Loader -->
    <div id="global-loader">
        <div class="loader-spinner"></div>
        <div class="loader-text">Loading AdvansE-Alert...</div>
    </div>
    <!-- Mobile Header -->
    <header class="top-header glass d-lg-none">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white p-0 me-3" id="sidebarToggle">
                <i class="bi bi-list fs-2"></i>
            </button>
            <h4 class="mb-0 fw-bold">AdvansE-Alert</h4>
        </div>
        <div class="user-avatar bg-primary rounded-circle" style="width: 32px; height: 32px;">
             <i class="bi bi-person-fill text-white d-flex align-items-center justify-content-center h-100"></i>
        </div>
    </header>

    <div class="sidebar shadow" id="sidebar">
        <div class="p-4 mb-4">
            <h4 class="mb-0 fw-bold text-accent">AdvansE-Alert</h4>
            <small class="text-dim">Communication Service</small>
        </div>

        <nav class="nav flex-column flex-grow-1">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Applications" ? "active" : "")" asp-controller="Admin" asp-action="Applications">
                <i class="bi bi-grid-1x2"></i> Applications
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SMTP" ? "active" : "")" asp-controller="Admin" asp-action="SMTP">
                <i class="bi bi-envelope-at"></i> SMTP Config
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SMSProviders" ? "active" : "")" asp-controller="Admin" asp-action="SMSProviders">
                <i class="bi bi-chat-left-dots"></i> SMS Providers
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BulkMessaging" && ViewContext.RouteData.Values["action"]?.ToString() == "Compose" ? "active" : "")" asp-controller="BulkMessaging" asp-action="Compose">
                <i class="bi bi-send-plus"></i> Compose Bulk
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BulkMessaging" && ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")" asp-controller="BulkMessaging" asp-action="History">
                <i class="bi bi-bar-chart-steps"></i> Bulk Reporting
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index">
                <i class="bi bi-people"></i> Contacts & Groups
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Templates" ? "active" : "")" asp-controller="Admin" asp-action="Templates">
                <i class="bi bi-file-earmark-code"></i> Templates
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Logs" ? "active" : "")" asp-controller="Admin" asp-action="Logs">
                <i class="bi bi-journal-text"></i> Audit Logs
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                <i class="bi bi-bar-chart-line"></i> Reports
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                <i class="bi bi-people"></i> User Management
            </a>

            <div class="mt-auto px-3 pb-4">
                <div class="p-3 glass rounded-4 mb-3 d-none d-lg-block">
                    <small class="text-dim text-uppercase fw-bold d-block mb-2" style="font-size: 0.7rem;">Developer Tools</small>
                    <a class="btn btn-sm btn-outline-info w-100 text-start" href="/api-docs" target="_blank">
                        <i class="bi bi-code-slash me-2"></i> API Docs
                    </a>
                </div>

                <div class="user-profile p-2 rounded-4 glass d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-person text-white"></i>
                        </div>
                        <div class="overflow-hidden" style="max-width: 120px;">
                            <div class="fw-bold text-truncate small">@User.Identity?.Name</div>
                            <small class="text-dim d-block" style="font-size: 0.7rem;">Administrator</small>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-link p-1 text-danger">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    </div>

    <div class="main-content">
        <!-- Desktop Header -->
        <header class="top-header d-none d-lg-flex">
            <div>
                <h3 class="mb-0 fw-bold">@ViewData["Title"]</h3>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-dim">Admin</a></li>
                        <li class="breadcrumb-item active text-main" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="glass p-2 px-3 rounded-pill small">
                    <span class="text-success fw-bold">●</span> System Online
                </div>
                <button class="btn btn-link text-dim p-0"><i class="bi bi-bell-fill fs-5"></i></button>
            </div>
        </header>

        <main role="main" class="p-3 p-lg-5 pt-4">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success glass border-success text-success alert-dismissible fade show mb-4 animate-fade-in" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger glass border-danger text-danger alert-dismissible fade show mb-4 animate-fade-in" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:999; backdrop-filter:blur(4px);"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            $('#sidebarToggle, #sidebarOverlay').on('click', function() {
                $('#sidebar').toggleClass('show');
                $('#sidebarOverlay').fadeToggle(200);
            });

            // Loader logic
            window.showLoader = function() {
                $('#global-loader').css('display', 'flex').hide().fadeIn(300);
            };

            window.hideLoader = function() {
                $('#global-loader').fadeOut(300);
            };

            // Show loader on form submissions
            $('form').on('submit', function() {
                if ($(this).valid ? $(this).valid() : true) {
                    showLoader();
                }
            });

            // Show loader on page transitions (links that are not buttons or toggles)
            $('a').on('click', function(e) {
                const href = $(this).attr('href');
                if (href && href !== '#' && !href.startsWith('javascript') && !$(this).attr('target')) {
                    showLoader();
                }
            });
        });
    </script>
    @await RenderSectionAsync("Modals", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
