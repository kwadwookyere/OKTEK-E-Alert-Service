@model EAlertService.ViewModels.PagedResult<EAlertService.Models.DomainModels.User>
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
    var roles = (IEnumerable<EAlertService.Models.DomainModels.Role>)ViewBag.Roles;
    var search = ViewBag.Search as string;
}

<div>
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h4 class="mb-0 fw-bold">System Users</h4>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <form method="get" class="d-flex gap-2">
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <input type="text" name="search" class="form-control glass text-white" placeholder="Search user..." value="@search" />
                        <button class="btn btn-outline-info" type="submit"><i class="bi bi-search"></i></button>
                        @if (!string.IsNullOrEmpty(search))
                        {
                            <a asp-action="Users" class="btn btn-outline-secondary text-dim" title="Clear search"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </form>
                <button class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#addUserModal">
                    <i class="bi bi-person-plus me-2"></i> Add New User
                </button>
            </div>
        </div>
    </div>

    <div class="card glass shadow-lg border-0 overflow-hidden">
        <div class="table-responsive" style="overflow: visible;">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Username & Email</th>
                        <th>Roles</th>
                        <th>Permissions</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary-subtle rounded-circle me-3 d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 40px; height: 40px;">
                                        @user.Username[0].ToString().ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold">@user.Username</div>
                                        <div class="small text-accent">@user.Email</div>
                                        <small class="text-dim">ID: #@user.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @foreach (var ur in user.UserRoles)
                                {
                                    <span class="badge glass border-accent text-accent small">@ur.Role.Name</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1" style="max-width: 300px;">
                                    @foreach (var ur in user.UserRoles)
                                    {
                                        foreach (var rp in ur.Role.RolePermissions)
                                        {
                                            <span class="text-dim x-small border rounded-pill px-2 py-0" style="font-size: 0.65rem;">@rp.Permission.Name</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge glass border-success text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge glass border-danger text-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-dim" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport">
                                        <i class="bi bi-three-dots-vertical fs-5"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end glass border-0 shadow-lg">
                                        <li><a class="dropdown-item py-2" href="#" onclick='openEditUserModal(@Json.Serialize(new { 
                                            id = user.Id, 
                                            username = user.Username, 
                                            email = user.Email,
                                            isActive = user.IsActive, 
                                            roleId = user.UserRoles.FirstOrDefault()?.RoleId 
                                        }))'><i class="bi bi-pencil me-2"></i> Edit User</a></li>
                                        <li><a class="dropdown-item py-2" href="#" onclick="openResetPasswordModal(@user.Id, '@user.Username')"><i class="bi bi-key me-2"></i> Reset Password</a></li>
                                        <li><hr class="dropdown-divider border-white opacity-10"></li>
                                        <li><a class="dropdown-item py-2 text-danger" href="#" onclick="confirmDeleteUser(@user.Id, '@user.Username')"><i class="bi bi-trash me-2"></i> Delete User</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Modals {
    <!-- Add User Modal -->
    <div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Add New User</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="CreateUser" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-dim small">Username</label>
                            <input type="text" name="username" class="form-control" required placeholder="johndoe">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Email Address</label>
                            <input type="email" name="email" class="form-control" required placeholder="john@example.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Password</label>
                            <input type="password" name="password" class="form-control" required placeholder="••••••••">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Role</label>
                            <select name="roleId" class="form-select" required>
                                @foreach (var role in roles)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="EditUser" method="post">
                    <input type="hidden" name="id" id="edit-user-id">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-dim small">Username</label>
                            <input type="text" name="username" id="edit-user-username" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Email Address</label>
                            <input type="email" name="email" id="edit-user-email" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Role</label>
                            <select name="roleId" id="edit-user-role" class="form-select" required>
                                @foreach (var role in roles)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" name="isActive" id="edit-user-active" value="true">
                            <label class="form-check-label text-dim" for="edit-user-active">User Account Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Reset Password Modal -->
    <div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title text-warning"><i class="bi bi-shield-lock me-2"></i> Reset Password</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" name="id" id="reset-user-id">
                    <div class="modal-body text-center py-4">
                        <p class="text-dim">Enter a new password for <span class="fw-bold text-white" id="reset-user-display"></span></p>
                        <div class="px-4">
                            <input type="password" name="password" class="form-control mb-2" required placeholder="New Password" minlength="6">
                            <small class="text-dim">Make sure it's at least 6 characters long.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold">Reset Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass border-danger-subtle">
                <div class="modal-header border-danger-subtle">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i> Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="DeleteUser" method="post">
                    <input type="hidden" name="id" id="delete-user-id">
                    <div class="modal-body text-center py-4">
                        <p class="text-dim">Are you sure you want to delete user <span class="fw-bold text-white" id="delete-user-display"></span>?</p>
                        <p class="text-danger small mb-0"><i class="bi bi-info-circle me-1"></i> This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer border-danger-subtle">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger shadow">Delete Permanently</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openEditUserModal(user) {
            document.getElementById('edit-user-id').value = user.id;
            document.getElementById('edit-user-username').value = user.username;
            document.getElementById('edit-user-email').value = user.email;
            document.getElementById('edit-user-active').checked = user.isActive;
            document.getElementById('edit-user-role').value = user.roleId;
            new bootstrap.Modal(document.getElementById('editUserModal')).show();
        }

        function openResetPasswordModal(id, username) {
            document.getElementById('reset-user-id').value = id;
            document.getElementById('reset-user-display').innerText = username;
            new bootstrap.Modal(document.getElementById('resetPasswordModal')).show();
        }

        function confirmDeleteUser(id, username) {
            document.getElementById('delete-user-id').value = id;
            document.getElementById('delete-user-display').innerText = username;
            new bootstrap.Modal(document.getElementById('deleteUserModal')).show();
        }
    </script>
}
