@model IEnumerable<EAlertService.Models.DomainModels.Application>
@{
    ViewData["Title"] = "Applications";
    Layout = "_AdminLayout";
}

<div class="animate-fade-in">
    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#addAppModal">
                <i class="bi bi-plus-lg me-2"></i> Register New Application
            </button>
        </div>
    </div>

@if (TempData["NewApiKey"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Important:</strong> Copy your new API Key now. Use the Reveal button (eye icon) in the table to see it anytime.
        <div class="mt-2 p-2 bg-dark rounded"><code>@TempData["NewApiKey"]</code></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


    <div class="card glass shadow-lg">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0 table-paginated" data-page-size="10">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>API Key (X-API-KEY)</th>
                    <th>Status</th>
                    <th>Registered At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td>@app.Id</td>
                        <td>@app.Name</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <code class="api-key-text me-2" id="key-@app.Id">••••••••••••••••</code>
                                <button class="btn btn-sm btn-link text-dim p-0 me-2" onclick="toggleApiKey(@app.Id, '@app.ApiKeyEncrypted')" title="Reveal">
                                    <i class="bi bi-eye" id="icon-@app.Id"></i>
                                </button>
                                <form asp-action="RegenerateApiKey" method="post" class="d-inline" onsubmit="return confirm('Regenerate API Key? Existing integrations using the old key will break.')">
                                    <input type="hidden" name="id" value="@app.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-warning p-0" title="Regenerate">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </form>
                            </div>
                        </td>

                        <td>
                            @if (app.IsEnabled)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Disabled</span>
                            }
                        </td>
                        <td>@app.CreatedAt.ToString("g")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-light me-1" onclick="openEditModal(@app.Id, '@app.Name', @app.IsEnabled.ToString().ToLower())"><i class="bi bi-pencil"></i></button>
                            <form asp-action="DeleteApplication" method="post" class="d-inline" onsubmit="return confirm('Delete this application and all its configurations?')">
                                <input type="hidden" name="id" value="@app.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Modals {
    <!-- Add Modal -->
    <div class="modal fade" id="addAppModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Register Application</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateApplication" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-dim small">Application Name</label>
                            <input type="text" name="name" class="form-control" required placeholder="e.g. Mobile Banking App">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editAppModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Application</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="EditApplication" method="post">
                    <input type="hidden" name="id" id="edit-app-id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-dim small">Application Name</label>
                            <input type="text" name="name" id="edit-app-name" class="form-control" required>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isEnabled" id="edit-app-enabled" value="true">
                            <label class="form-check-label text-dim" for="edit-app-enabled">Enabled</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleApiKey(id, key) {
            const textElem = document.getElementById(`key-${id}`);
            const iconElem = document.getElementById(`icon-${id}`);
            
            if (!key || key === '') {
                alert('API Key is not retrievable for this application. Please use the "Regenerate" button to set a new one.');
                return;
            }

            if (textElem.innerText.includes('•')) {
                textElem.innerText = key;
                iconElem.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                textElem.innerText = '••••••••••••••••';
                iconElem.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        let editModalObj = null;
        function openEditModal(id, name, isEnabled) {
            document.getElementById('edit-app-id').value = id;
            document.getElementById('edit-app-name').value = name;
            document.getElementById('edit-app-enabled').checked = (isEnabled === true || isEnabled === 'true');
            
            if (!editModalObj) {
                editModalObj = new bootstrap.Modal(document.getElementById('editAppModal'));
            }
            editModalObj.show();
        }
    </script>
    }
</div>


