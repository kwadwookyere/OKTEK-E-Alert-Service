@model EAlertService.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Admin Login";
    Layout = null; // Clean login page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdvansE-Alert</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-bg: #030712;
            --accent-primary: #38bdf8;
            --accent-secondary: #818cf8;
            --text-main: #f8fafc;
            --text-dim: #94a3b8;
            --glass: rgba(17, 24, 39, 0.6);
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        body {
            background-color: var(--primary-bg);
            background-image: url('/images/login-bg.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: var(--text-main);
            font-family: 'Outfit', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        .login-wrapper {
            width: 100%;
            padding: 2rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-card {
            background: var(--glass);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--glass-border);
            border-radius: 2rem;
            padding: 3.5rem;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
            position: relative;
            z-index: 10;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, var(--accent-primary), transparent, var(--accent-secondary));
            border-radius: 2rem;
            z-index: -1;
            opacity: 0.2;
        }

        .logo-section {
            text-align: center;
            margin-bottom: 3rem;
        }

        .logo-text {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            background: linear-gradient(135deg, #fff 0%, var(--text-dim) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo-subtext {
            color: var(--accent-primary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            font-weight: 600;
            margin-top: 0.5rem;
            display: block;
        }

        .form-label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-dim);
            margin-bottom: 0.75rem;
        }

        .input-group {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 1rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .input-group:focus-within {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
        }

        .input-group-text {
            background: transparent;
            border: none;
            color: var(--text-dim);
            padding-left: 1.25rem;
        }

        .form-control {
            background: transparent !important;
            border: none !important;
            color: white !important;
            padding: 1rem 1.25rem 1rem 0.5rem !important;
            font-weight: 500;
        }

        .form-control:focus {
            background: transparent !important;
            color: white !important;
            box-shadow: none !important;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.3) !important;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)) !important;
            border: none !important;
            padding: 1.1rem !important;
            font-weight: 700 !important;
            border-radius: 1rem !important;
            margin-top: 1rem !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 0.95rem;
        }

        .btn-primary:hover {
            transform: translateY(-3px) !important;
            box-shadow: 0 12px 25px rgba(56, 189, 248, 0.4) !important;
            filter: brightness(1.1);
        }

        .form-check-input {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border-color: var(--glass-border) !important;
            width: 1.2em;
            height: 1.2em;
        }

        .form-check-input:checked {
            background-color: var(--accent-primary) !important;
            border-color: var(--accent-primary) !important;
        }

        .forgot-link {
            color: var(--text-dim);
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: var(--accent-primary);
        }

        .animate-fade-in {
            animation: fadeIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .alert {
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 1rem 1.5rem;
            font-weight: 500;
            background: rgba(17, 24, 39, 0.8);
            backdrop-filter: blur(10px);
        }

        .alert-success { color: #34d399; border-color: rgba(52, 211, 153, 0.2); }
        .alert-danger { color: #f87171; border-color: rgba(248, 113, 113, 0.2); }

    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card animate-fade-in">
            <div class="logo-section">
                <span class="logo-text">AdvansE-Alert</span>
                <span class="logo-subtext">Communication Suite</span>
            </div>
            
            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success mt-2 mb-4">
                        <i class="bi bi-check2-circle me-2"></i> @TempData["Message"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mt-2 mb-4">
                        <i class="bi bi-exclamation-octagon me-2"></i> @TempData["Error"]
                    </div>
                }
                
                <div class="mb-4">
                    <label asp-for="Username" class="form-label">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="Enter your username" required />
                    </div>
                    <span asp-validation-for="Username" class="text-danger x-small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger x-small"></span>
                </div>

                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-dim ms-1">Stay signed in</label>
                    </div>
                    <a asp-action="ForgotPassword" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 shadow-lg">
                    Access Dashboard <i class="bi bi-arrow-right-short ms-1 fs-5"></i>
                </button>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
