@model EAlertService.ViewModels.CommunicationLogViewModel
@{
    ViewData["Title"] = "Communication Log";
    Layout = "_AdminLayout";
}

<div class="card glass p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">Application</label>
            <select name="app" class="form-select glass text-white">
                <option value="">All Applications</option>
                @foreach (var app in Model.Applications)
                {
                    <option value="@app" selected="@(Model.SelectedApp == app)">@app</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">Type</label>
            <select name="type" class="form-select glass text-white">
                <option value="">All Types</option>
                <option value="Email" selected="@(Model.SelectedType == "Email")">Email</option>
                <option value="SMS" selected="@(Model.SelectedType == "SMS")">SMS</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">Status</label>
            <select name="status" class="form-select glass text-white">
                <option value="">All Statuses</option>
                <option value="Sent" selected="@(Model.SelectedStatus == "Sent")">Sent</option>
                <option value="Failed" selected="@(Model.SelectedStatus == "Failed")">Failed</option>
                <option value="Pending" selected="@(Model.SelectedStatus == "Pending")">Pending</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">From</label>
            <input type="date" name="start" class="form-control glass text-white" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">To</label>
            <input type="date" name="end" class="form-control glass text-white" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4 flex-grow-1">Filter</button>
            <a asp-action="ExportCsv" asp-route-app="@Model.SelectedApp" asp-route-type="@Model.SelectedType" asp-route-status="@Model.SelectedStatus" asp-route-start="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-end="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-success glass border-success text-success" title="Export CSV">
                <i class="bi bi-download"></i>
            </a>
        </div>
    </form>
</div>

<div class="card glass shadow-lg overflow-hidden">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="bg-white bg-opacity-5">
                <tr>
                    <th class="ps-4">Time</th>
                    <th>Type</th>
                    <th>App</th>
                    <th>Recipient</th>
                    <th>Subject / Message</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.EmailLogs)
                {
                    <tr>
                        <td class="ps-4"><span class="text-dim small">@log.Timestamp.ToString("G")</span></td>
                        <td><span class="badge bg-primary bg-opacity-10 text-primary small">Email</span></td>
                        <td><span class="fw-medium">@log.Application.Name</span></td>
                        <td>@log.Recipient</td>
                        <td>
                            <div class="text-truncate" style="max-width: 300px;" title="@log.Subject">@log.Subject</div>
                        </td>
                        <td>
                            @if (log.Status == "Sent") { <span class="badge glass border-success text-success">Sent</span> }
                            else if (log.Status == "Failed") { <span class="badge glass border-danger text-danger">Failed</span> }
                            else { <span class="badge glass border-warning text-warning">@log.Status</span> }
                        </td>
                    </tr>
                }
                @foreach (var log in Model.SmsLogs)
                {
                    <tr>
                        <td class="ps-4"><span class="text-dim small">@log.Timestamp.ToString("G")</span></td>
                        <td><span class="badge bg-warning bg-opacity-10 text-warning small">SMS</span></td>
                        <td><span class="fw-medium">@log.Application.Name</span></td>
                        <td>@log.Recipient</td>
                        <td>
                            <div class="text-truncate text-dim" style="max-width: 300px;" title="@log.Message">@log.Message</div>
                        </td>
                        <td>
                            @if (log.Status == "Sent") { <span class="badge glass border-success text-success">Sent</span> }
                            else if (log.Status == "Failed") { <span class="badge glass border-danger text-danger">Failed</span> }
                            else { <span class="badge glass border-warning text-warning">@log.Status</span> }
                        </td>
                    </tr>
                }
                @if (!Model.EmailLogs.Any() && !Model.SmsLogs.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-dim">No records found matching the filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
