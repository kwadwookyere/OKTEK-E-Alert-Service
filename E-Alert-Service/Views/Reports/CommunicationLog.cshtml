@model EAlertService.ViewModels.CommunicationLogViewModel
@{
    ViewData["Title"] = "Communication Log";
    Layout = "_AdminLayout";
}

<div class="card glass p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">Application</label>
            <select name="app" class="form-select glass text-white">
                <option value="">All Applications</option>
                @foreach (var app in Model.Applications)
                {
                    <option value="@app" selected="@(Model.SelectedApp == app)">@app</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">Type</label>
            <select name="type" class="form-select glass text-white">
                <option value="">All Types</option>
                <option value="Email" selected="@(Model.SelectedType == "Email")">Email</option>
                <option value="SMS" selected="@(Model.SelectedType == "SMS")">SMS</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">Status</label>
            <select name="status" class="form-select glass text-white">
                <option value="">All Statuses</option>
                <option value="Sent" selected="@(Model.SelectedStatus == "Sent")">Sent</option>
                <option value="Failed" selected="@(Model.SelectedStatus == "Failed")">Failed</option>
                <option value="Pending" selected="@(Model.SelectedStatus == "Pending")">Pending</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">From</label>
            <input type="date" name="start" class="form-control glass text-white" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-dim uppercase">To</label>
            <input type="date" name="end" class="form-control glass text-white" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4 flex-grow-1">Filter</button>
            <a asp-action="ExportCsv" asp-route-app="@Model.SelectedApp" asp-route-type="@Model.SelectedType" asp-route-status="@Model.SelectedStatus" asp-route-start="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-end="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-success glass border-success text-success" title="Export CSV">
                <i class="bi bi-download"></i>
            </a>
        </div>
    </form>
</div>

<div class="card glass shadow-lg overflow-hidden">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="bg-white bg-opacity-5">
                <tr>
                    <th class="ps-4">Time</th>
                    <th>Type</th>
                    <th>App</th>
                    <th>Recipient</th>
                    <th>Subject / Message</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td class="ps-4"><span class="text-dim small">@log.Timestamp.ToString("G")</span></td>
                        <td>
                            @if (log.Type == "Email")
                            {
                                <span class="badge bg-primary bg-opacity-15 text-primary border border-primary border-opacity-25 small">
                                    <i class="bi bi-envelope-fill me-1"></i> Email
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 small">
                                    <i class="bi bi-chat-left-dots-fill me-1"></i> SMS
                                </span>
                            }
                        </td>
                        <td><span class="fw-medium text-white">@log.ApplicationName</span></td>
                        <td><span class="text-break">@log.Recipient</span></td>
                        <td>
                            <div class="text-truncate" style="max-width: 320px;" title="@log.SubjectOrMessage">
                                @log.SubjectOrMessage
                            </div>
                            @if (!string.IsNullOrEmpty(log.ErrorMessage))
                            {
                                <small class="text-danger d-block text-truncate" style="max-width: 320px;" title="@log.ErrorMessage">
                                    <i class="bi bi-exclamation-circle me-1"></i>@log.ErrorMessage
                                </small>
                            }
                        </td>
                        <td>
                            @if (log.Status == "Sent") { <span class="badge glass border-success text-success">Sent</span> }
                            else if (log.Status == "Failed") { <span class="badge glass border-danger text-danger">Failed</span> }
                            else { <span class="badge glass border-warning text-warning">@log.Status</span> }
                        </td>
                        <td class="text-end pe-4">
                            @if (log.Type == "Email")
                            {
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-info" title="View email content and tracking details" onclick="openViewEmailModal(@log.Id)">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                    <button type="button" class="btn btn-outline-warning" title="Resend this email" onclick="confirmResendEmail(@log.Id, '@Html.Raw(Html.Encode(log.Recipient))')">
                                        <i class="bi bi-arrow-repeat"></i> Resend
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-dim small">—</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-dim">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-dim opacity-50"></i>
                            No communication log records found matching the filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", Model)
</div>

@section Modals {
    @await Html.PartialAsync("_EmailViewModals")
    @await Html.PartialAsync("_NewMessageModal")
}
