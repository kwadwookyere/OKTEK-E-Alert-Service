@{
    ViewData["Title"] = "System Overview";
    Layout = "_AdminLayout";
}

<div class="row g-4 mb-5">
    <div class="col-12 col-md-6 col-xl-4 animate-fade-in" style="animation-delay: 0.1s;">
        <div class="card glass stat-card glass-hover h-100 p-4" style="border-left: 4px solid var(--accent-primary);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-dim mb-1 fw-medium uppercase small" style="letter-spacing: 0.05em;">Total Applications</p>
                    <h2 class="mb-0 fw-bold">@ViewBag.AppsCount</h2>
                    <div class="mt-2 small text-accent">
                        <i class="bi bi-arrow-up-right me-1"></i> Active Channels
                    </div>
                </div>
                <div class="rounded-4 bg-primary bg-opacity-10 p-3 text-accent shadow-sm">
                    <i class="bi bi-grid-1x2 fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-4 animate-fade-in" style="animation-delay: 0.2s;">
        <div class="card glass stat-card glass-hover h-100 p-4" style="border-left: 4px solid var(--accent-success);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-dim mb-1 fw-medium uppercase small" style="letter-spacing: 0.05em;">Email Traffic</p>
                    <h2 class="mb-0 fw-bold">@ViewBag.EmailLogsCount</h2>
                    <div class="mt-2 small text-success">
                        <i class="bi bi-check-all me-1"></i> Successfully Sent
                    </div>
                </div>
                <div class="rounded-4 bg-success bg-opacity-10 p-3 text-success shadow-sm">
                    <i class="bi bi-envelope-check fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-4 animate-fade-in" style="animation-delay: 0.3s;">
        <div class="card glass stat-card glass-hover h-100 p-4" style="border-left: 4px solid var(--accent-warning);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-dim mb-1 fw-medium uppercase small" style="letter-spacing: 0.05em;">SMS Delivery</p>
                    <h2 class="mb-0 fw-bold">@ViewBag.SmsLogsCount</h2>
                    <div class="mt-2 small text-warning">
                        <i class="bi bi-broadcast me-1"></i> SMS Gateway
                    </div>
                </div>
                <div class="rounded-4 bg-warning bg-opacity-10 p-3 text-warning shadow-sm">
                    <i class="bi bi-chat-left-text fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row animate-fade-in" style="animation-delay: 0.4s;">
    <div class="col-12">
        <div class="card glass p-4 p-lg-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h4 class="fw-bold mb-2">Quick Commands</h4>
                    <p class="text-dim mb-4">Jump straight to configuration and management modules.</p>
                    
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <a asp-action="Applications" class="btn btn-primary d-flex align-items-center justify-content-center py-3 w-100 h-100">
                                <i class="bi bi-plus-circle-dotted me-2 fs-5"></i> New App
                            </a>
                        </div>
                        <div class="col-sm-4">
                            <a asp-action="SMTP" class="btn btn-outline-light d-flex align-items-center justify-content-center py-3 w-100 h-100 glass-hover">
                                <i class="bi bi-gear-wide-connected me-2 fs-5"></i> SMTP
                            </a>
                        </div>
                        <div class="col-sm-4">
                            <a asp-action="SMSProviders" class="btn btn-outline-light d-flex align-items-center justify-content-center py-3 w-100 h-100 glass-hover">
                                <i class="bi bi-phone-vibrate me-2 fs-5"></i> SMS
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 d-none d-lg-block text-center">
                    <div class="rounded-circle bg-accent-primary bg-opacity-10 d-inline-flex p-5 shadow-lg border border-white border-opacity-10">
                        <i class="bi bi-lightning-charge-fill text-accent fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
