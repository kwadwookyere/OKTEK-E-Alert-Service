@model IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.SmtpConfiguration>
@{
    ViewData["Title"] = "SMTP Configurations";
    Layout = "_AdminLayout";
}

<div class="animate-fade-in">
    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#addSmtpModal">
                <i class="bi bi-plus-lg me-2"></i> Add SMTP Config
            </button>
        </div>
    </div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

    <div class="card glass shadow-lg">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
            <thead>
                <tr>
                    <th>App</th>
                    <th>Host</th>
                    <th>Port</th>
                    <th>Username</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var config in Model)
                {
                    <tr>
                        <td>@config.Application.Name</td>
                        <td>@config.Host</td>
                        <td>@config.Port</td>
                        <td>@config.Username</td>
                        <td>@config.Priority</td>
                        <td>
                            @if (config.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-info" onclick="openTestModal(@config.Id, '@config.Host')">
                                    <i class="bi bi-send-check"></i> Test
                                </button>
                                <button class="btn btn-sm btn-outline-light" onclick='openEditSmtpModal(@Json.Serialize(new { 
                                    id = config.Id, 
                                    applicationId = config.ApplicationId, 
                                    host = config.Host, 
                                    port = config.Port, 
                                    username = config.Username, 
                                    fromEmail = config.FromEmail, 
                                    fromName = config.FromName, 
                                    priority = config.Priority, 
                                    enableSsl = config.EnableSsl,
                                    isActive = config.IsActive 
                                }))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="DeleteSmtp" method="post" onsubmit="return confirm('Delete this SMTP configuration?')">
                                    <input type="hidden" name="id" value="@config.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Modals {
    <!-- Add Modal -->
    <div class="modal fade" id="addSmtpModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Add SMTP Configuration</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateSmtp" method="post">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Application</label>
                                <select name="ApplicationId" class="form-select">
                                    @foreach (var app in (IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.Application>)ViewBag.Applications)
                                    {
                                        <option value="@app.Id">@app.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Priority (1=High, 9=Low)</label>
                                <input type="number" name="Priority" class="form-control" value="1" min="1" max="9" required>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label text-dim small">SMTP Host</label>
                                <input type="text" name="Host" class="form-control" required placeholder="smtp.gmail.com">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-dim small">Port</label>
                                <input type="number" name="Port" class="form-control" value="587" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Username</label>
                                <input type="text" name="Username" class="form-control" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Password</label>
                                <input type="password" name="Password" class="form-control" required autocomplete="new-password">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">From Email</label>
                                <input type="email" name="FromEmail" class="form-control" required placeholder="noreply@domain.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">From Name</label>
                                <input type="text" name="FromName" class="form-control" placeholder="Company Alerts">
                            </div>
                             <div class="col-md-6 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="EnableSsl" value="true" checked>
                                    <label class="form-check-label text-dim">Enable SSL/TLS</label>
                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked>
                                    <label class="form-check-label text-dim">Is Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Config</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editSmtpModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Edit SMTP Configuration</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="EditSmtp" method="post">
                    <input type="hidden" name="Id" id="edit-smtp-id" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Application</label>
                                <select name="ApplicationId" id="edit-smtp-appid" class="form-select">
                                    @foreach (var app in (IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.Application>)ViewBag.Applications)
                                    {
                                        <option value="@app.Id">@app.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Priority (1=High, 9=Low)</label>
                                <input type="number" name="Priority" id="edit-smtp-priority" class="form-control" min="1" max="9" required>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label text-dim small">SMTP Host</label>
                                <input type="text" name="Host" id="edit-smtp-host" class="form-control" required placeholder="smtp.gmail.com">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-dim small">Port</label>
                                <input type="number" name="Port" id="edit-smtp-port" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Username</label>
                                <input type="text" name="Username" id="edit-smtp-user" class="form-control" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small text-warning">Password (Leave blank to keep current)</label>
                                <input type="password" name="Password" class="form-control" autocomplete="new-password">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">From Email</label>
                                <input type="email" name="FromEmail" id="edit-smtp-fromemail" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">From Name</label>
                                <input type="text" name="FromName" id="edit-smtp-fromname" class="form-control">
                            </div>
                            <div class="col-md-6 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="EnableSsl" id="edit-smtp-ssl" value="true">
                                    <label class="form-check-label text-dim" for="edit-smtp-ssl">Enable SSL/TLS</label>
                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsActive" id="edit-smtp-active" value="true">
                                    <label class="form-check-label text-dim" for="edit-smtp-active">Is Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Config</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Test Modal -->
    <div class="modal fade" id="testSmtpModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Test Connection</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="TestSmtp" method="post">
                    <input type="hidden" name="id" id="test-smtp-id" />
                    <div class="modal-body">
                        <p class="text-dim">Send a test email through: <strong id="test-smtp-host-label" class="text-white"></strong></p>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Recipient Email</label>
                            <input type="email" name="toEmail" class="form-control" required placeholder="test@example.com">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-info shadow-lg">Run Test</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openEditSmtpModal(config) {
            document.getElementById('edit-smtp-id').value = config.id || config.Id;
            document.getElementById('edit-smtp-appid').value = config.applicationId || config.ApplicationId;
            document.getElementById('edit-smtp-host').value = config.host || config.Host;
            document.getElementById('edit-smtp-port').value = config.port || config.Port;
            document.getElementById('edit-smtp-user').value = config.username || config.Username;
            document.getElementById('edit-smtp-fromemail').value = config.fromEmail || config.FromEmail;
            document.getElementById('edit-smtp-fromname').value = config.fromName || config.FromName;
            document.getElementById('edit-smtp-priority').value = config.priority || config.Priority;
            document.getElementById('edit-smtp-ssl').checked = config.enableSsl || config.EnableSsl;
            document.getElementById('edit-smtp-active').checked = config.isActive || config.IsActive;
            
            new bootstrap.Modal(document.getElementById('editSmtpModal')).show();
        }

        function openTestModal(id, host) {
            document.getElementById('test-smtp-id').value = id;
            document.getElementById('test-smtp-host-label').innerText = host;
            new bootstrap.Modal(document.getElementById('testSmtpModal')).show();
        }
    </script>
    }
</div>

