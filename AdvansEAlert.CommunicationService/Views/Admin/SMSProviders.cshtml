@model IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.SmsProviderConfiguration>
@{
    ViewData["Title"] = "SMS Providers";
    Layout = "_AdminLayout";
}

<div class="animate-fade-in">
    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#addSmsModal">
                <i class="bi bi-plus-lg me-2"></i> Add SMS Provider
            </button>
        </div>
    </div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

    <div class="card glass shadow-lg">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
            <thead>
                <tr>
                    <th>App</th>
                    <th>Provider</th>
                    <th>Sender ID</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var provider in Model)
                {
                    <tr>
                        <td>@provider.Application.Name</td>
                        <td>@provider.ProviderName</td>
                        <td>@provider.SenderId</td>
                        <td>@provider.Priority</td>
                        <td>
                            @if (provider.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <form asp-action="TestSmsProvider" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@provider.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-send-check"></i> Test
                                    </button>
                                </form>
                                <button class="btn btn-sm btn-outline-light" onclick='openEditSmsModal(@Json.Serialize(new { 
                                    id = provider.Id, 
                                    applicationId = provider.ApplicationId, 
                                    providerName = provider.ProviderName, 
                                    senderId = provider.SenderId, 
                                    priority = provider.Priority, 
                                    isActive = provider.IsActive 
                                }))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="DeleteSmsProvider" method="post" onsubmit="return confirm('Delete this SMS provider?')">
                                    <input type="hidden" name="id" value="@provider.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Modals {
    <!-- Add Modal -->
    <div class="modal fade" id="addSmsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Add SMS Provider</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateSmsProvider" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-dim small">Application</label>
                            <select name="ApplicationId" class="form-select">
                                @foreach (var app in (IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.Application>)ViewBag.Applications)
                                {
                                    <option value="@app.Id">@app.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Provider Name (e.g. Twilio, Hubtel)</label>
                            <input type="text" name="ProviderName" class="form-control" required placeholder="Twilio">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Sender ID / From Number</label>
                            <input type="text" name="SenderId" class="form-control" required placeholder="ALERTS">
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-dim small">Account SID / API ID</label>
                                <input type="text" name="ApiKey" class="form-control" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-dim small">Auth Token / API Secret</label>
                                <input type="password" name="ApiSecret" class="form-control" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Priority (1=High, 9=Low)</label>
                            <input type="number" name="Priority" class="form-control" value="1" min="1" max="9" required>
                        </div>
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked>
                            <label class="form-check-label text-dim">Enabled</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Provider</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editSmsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">Edit SMS Provider</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="EditSmsProvider" method="post">
                    <input type="hidden" name="Id" id="edit-sms-id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-dim small">Application</label>
                            <select name="ApplicationId" id="edit-sms-appid" class="form-select">
                                @foreach (var app in (IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.Application>)ViewBag.Applications)
                                {
                                    <option value="@app.Id">@app.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Provider Name</label>
                            <input type="text" name="ProviderName" id="edit-sms-name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Sender ID</label>
                            <input type="text" name="SenderId" id="edit-sms-sender" class="form-control" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-dim small text-warning">API ID (Leave blank to keep)</label>
                                <input type="text" name="ApiKey" class="form-control">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-dim small text-warning">API Secret (Leave blank to keep)</label>
                                <input type="password" name="ApiSecret" class="form-control">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Priority</label>
                            <input type="number" name="Priority" id="edit-sms-priority" class="form-control" required min="1">
                        </div>
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" name="IsActive" id="edit-sms-active" value="true">
                            <label class="form-check-label text-dim" for="edit-sms-active">Enabled</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Provider</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openEditSmsModal(provider) {
            document.getElementById('edit-sms-id').value = provider.id || provider.Id;
            document.getElementById('edit-sms-appid').value = provider.applicationId || provider.ApplicationId;
            document.getElementById('edit-sms-name').value = provider.providerName || provider.ProviderName;
            document.getElementById('edit-sms-sender').value = provider.senderId || provider.SenderId;
            document.getElementById('edit-sms-priority').value = provider.priority || provider.Priority;
            document.getElementById('edit-sms-active').checked = provider.isActive || provider.IsActive;
            
            new bootstrap.Modal(document.getElementById('editSmsModal')).show();
        }
    </script>
    }
</div>

