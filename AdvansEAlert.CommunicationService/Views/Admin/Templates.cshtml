@model IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.EmailTemplate>
@{
    ViewData["Title"] = "Messaging Templates";
    Layout = "_AdminLayout";
    var smsTemplates = (IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.SmsTemplate>)ViewBag.SmsTemplates;
}

<div class="animate-fade-in">
    <ul class="nav nav-pills glass p-1 rounded-4 mb-4 d-inline-flex" id="templateTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-4 px-4" id="email-tab" data-bs-toggle="tab" data-bs-target="#email-pane" type="button">Email Templates</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-4 px-4" id="sms-tab" data-bs-toggle="tab" data-bs-target="#sms-pane" type="button">SMS Templates</button>
        </li>
    </ul>

    <div class="tab-content" id="templateTabsContent">
        <div class="tab-pane fade show active" id="email-pane" role="tabpanel">
            <div class="row mb-4">
                <div class="col-12">
                    <button class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#addEmailTemplateModal">
                        <i class="bi bi-plus-lg me-2"></i> New Email Template
                    </button>
                </div>
            </div>
            <div class="card glass shadow-lg">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>App</th>
                                <th>Template Name</th>
                                <th>Subject</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td><span class="text-accent fw-bold small">@t.Application.Name</span></td>
                                    <td>@t.Name</td>
                                    <td>@t.Subject</td>
                                    <td>
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-info glass-hover">Preview</button>
                                            <button class="btn btn-sm btn-outline-danger glass-hover"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="sms-pane" role="tabpanel">
            <div class="row mb-4">
                <div class="col-12">
                    <button class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#addSmsTemplateModal">
                        <i class="bi bi-plus-lg me-2"></i> New SMS Template
                    </button>
                </div>
            </div>
            <div class="card glass shadow-lg">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>App</th>
                                <th>Template Name</th>
                                <th>Content Preview</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in smsTemplates)
                            {
                                <tr>
                                    <td><span class="text-accent fw-bold small">@t.Application.Name</span></td>
                                    <td>@t.Name</td>
                                    <td><span class="text-dim">@(t.Content.Length > 50 ? t.Content[..50] + "..." : t.Content)</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger glass-hover"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <!-- Email Template Modal -->
    <div class="modal fade" id="addEmailTemplateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">New Email Template</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateEmailTemplate" method="post">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Application</label>
                                <select name="ApplicationId" class="form-select">
                                    @foreach (var app in (IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.Application>)ViewBag.Applications)
                                    {
                                        <option value="@app.Id">@app.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dim small">Template Name</label>
                                <input type="text" name="Name" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-dim small">Email Subject</label>
                                <input type="text" name="Subject" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-dim small">Body HTML (Use {{Name}}, {{Code}} etc.)</label>
                                <textarea name="BodyHtml" rows="12" class="form-control" required></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Template</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SMS Template Modal -->
    <div class="modal fade" id="addSmsTemplateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">New SMS Template</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateSmsTemplate" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-dim small">Application</label>
                            <select name="ApplicationId" class="form-select">
                                @foreach (var app in (IEnumerable<AdvansEAlert.CommunicationService.Models.DomainModels.Application>)ViewBag.Applications)
                                {
                                    <option value="@app.Id">@app.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Template Name</label>
                            <input type="text" name="Name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dim small">Content</label>
                            <textarea name="Content" rows="4" class="form-control" required maxlength="500"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light glass-active" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Template</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
