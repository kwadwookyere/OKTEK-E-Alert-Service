@model AdvansEAlert.CommunicationService.ViewModels.ContactListViewModel
@{
    ViewData["Title"] = "Contact Management";
    Layout = "_AdminLayout";
}

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0">Contact & Group Management</h4>
            <p class="text-dim mb-0">Manage your recipients and segment them into groups.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateGroup" class="btn btn-outline-light glass-hover rounded-pill px-4">
                <i class="bi bi-folder-plus me-2"></i> Create Group
            </a>
            <a asp-action="CreateContact" class="btn btn-primary rounded-pill px-4 shadow">
                <i class="bi bi-person-plus me-2"></i> Add Contact
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Groups Section -->
        <div class="col-lg-4">
            <div class="card glass shadow-sm h-100 p-4">
                <h5 class="fw-bold mb-4">Groups</h5>
                <div class="list-group list-group-flush bg-transparent">
                    @if (!Model.Groups.Any())
                    {
                        <div class="text-center py-5 text-dim">
                            <i class="bi bi-folder2-open fs-1 d-block mb-3 opacity-25"></i>
                            No groups created yet.
                        </div>
                    }
                    @foreach (var group in Model.Groups)
                    {
                        <div class="list-group-item bg-transparent border-0 px-0 mb-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1 fw-bold">@group.Name</h6>
                                    <p class="small text-dim mb-1">@group.Description</p>
                                    <span class="badge bg-secondary bg-opacity-10 text-accent rounded-pill">
                                        @group.Application.Name
                                    </span>
                                </div>
                                <form asp-action="DeleteGroup" asp-route-id="@group.Id" method="post" onsubmit="return confirm('Delete this group? Contacts will not be deleted.');">
                                    <button type="submit" class="btn btn-link text-danger p-0">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Contacts Section -->
        <div class="col-lg-8">
            <div class="card glass shadow-sm p-4">
                <h5 class="fw-bold mb-4">Contacts</h5>
                <div class="table-responsive">
                    <table class="table table-hover text-white">
                        <thead class="text-dim small uppercase">
                            <tr>
                                <th>Name</th>
                                <th>Email / Phone</th>
                                <th>App</th>
                                <th>Groups</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Contacts.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-dim">
                                        No contacts found.
                                    </td>
                                </tr>
                            }
                            @foreach (var contact in Model.Contacts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@contact.Name</div>
                                        <div class="small text-dim">Added @contact.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <div>@contact.Email</div>
                                        <div class="small text-dim">@contact.PhoneNumber</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-accent">@contact.Application.Name</span>
                                    </td>
                                    <td>
                                        @foreach (var assignment in contact.GroupAssignments)
                                        {
                                            <span class="badge rounded-pill border border-white border-opacity-25 text-white small me-1">
                                                @assignment.ContactGroup.Name
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="EditContact" asp-route-id="@contact.Id" class="btn btn-sm btn-link text-white-50">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="DeleteContact" asp-route-id="@contact.Id" method="post" onsubmit="return confirm('Are you sure?');">
                                                <button type="submit" class="btn btn-sm btn-link text-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
